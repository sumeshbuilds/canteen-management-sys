# Copy this file to .env and adjust the values. Never commit .env.

# Flask session/flash signing key. Required in production.
SECRET_KEY=replace-with-a-long-random-value

# Set to 0 to disable the debug reloader (production uses a WSGI server instead).
FLASK_DEBUG=1

# Optional: point the app at a different database file (Phase 1+ / SQLAlchemy).
# DATABASE_URL=sqlite:///C:/path/to/canteen.db

# Set to 1 when serving over HTTPS.
SESSION_COOKIE_SECURE=0
